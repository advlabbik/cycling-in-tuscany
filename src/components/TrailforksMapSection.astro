---
/**
 * Mappa Trailforks di una bike area, embeddata in pagina.
 *
 * Si usa l'endpoint widget `/widgets/region_map/`, NON la pagina pubblica della
 * regione: quella risponde `frame-ancestors 'self'` e il browser la rifiuta in
 * iframe (verificato 18/8). Il widget invece non manda ne' CSP ne'
 * X-Frame-Options, quindi si puo' incorporare.
 *
 * La mappa e' viva: i sentieri, i gradi e le chiusure li aggiornano i rider che
 * curano l'area, quindi qui non si copiano tracciati a mano — si mostra la loro.
 * Il widget mette cookie propri (dominio trailforks.com): citato nella cookie
 * policy, sezione "Sites we link to".
 */
interface Props {
  /** id regione Trailforks, dallo slug dell'URL (es. .../monte-calvi-trail-area-33427) */
  rid: number;
  title: string;
  text: string;
  badge?: string;
  /** link alla pagina pubblica della regione, per chi vuole approfondire */
  href: string;
  note?: string;
  white?: boolean;
}

const { rid, title, text, badge, href, note, white = false } = Astro.props;
const embedUrl = `https://www.trailforks.com/widgets/region_map/?rid=${rid}`;
---

<section style={white ? 'background:#fff' : undefined}>
  <div class="wrap">
    {badge && <div class="ribbon" style="margin-bottom:10px">{badge}</div>}
    <h2 class="sec">{title}</h2>
    <p class="sub">{text}</p>
    <div class="tfcard">
      <iframe src={embedUrl} title={title} loading="lazy"></iframe>
    </div>
    <p class="muted small" style="margin-top:12px">
      {note || 'Trail grades and closures are kept up to date by the local riders.'}
      {' '}
      <a href={href} target="_blank" rel="noopener">Open the full area on Trailforks →</a>
    </p>
    <slot />
  </div>
</section>

<style>
  .tfcard{border-radius:16px;overflow:hidden;border:1px solid var(--border);box-shadow:var(--shadow-md);background:var(--surface);transform:translateZ(0)}
  .tfcard iframe{display:block;width:100%;height:520px;border:0}
  @media(max-width:820px){.tfcard iframe{height:440px}}
</style>
