---
import type { CollectionEntry } from 'astro:content';
import { site } from '../../site.config';
import { bgUrl } from '../lib/images';
// #45: la libreria arriva dal bundle, non più da unpkg — versione nel lockfile,
// file serviti dal nostro dominio, niente CDN terza da cui dipendere.
import 'maplibre-gl/dist/maplibre-gl.css';

/**
 * La miniatura dentro il popup è alta 134px in un box da 218px: servire lì la hero
 * a piena risoluzione voleva dire scaricare 1,6 MB per un francobollo (#42).
 * 440 = 218 al 2x.
 */
const POPUP_WIDTH = 440;

interface Props {
  territories: CollectionEntry<'territori'>[];
  structures: CollectionEntry<'strutture'>[];
}

const { territories, structures } = Astro.props;
const getSlug = (id: string) => id.replace(/\.md$/, '');
import { stay22RoamUrl } from '../lib/stay22';

const stay22 = (lat: number, lng: number) => stay22RoamUrl(lat, lng);

const territoryMarker = async (entry: CollectionEntry<'territori'>) => ({
  name: entry.data.name,
  kind: entry.data.tier === 'premium' ? 'premium' : 'territory',
  lat: entry.data.coords.lat,
  lng: entry.data.coords.lng,
  page: `/territori/${getSlug(entry.id)}`,
  book: stay22(entry.data.coords.lat, entry.data.coords.lng),
  sub: entry.data.area,
  img: await bgUrl(entry.data.heroImage, POPUP_WIDTH),
  rp: entry.data.ridePack?.length ? 'routes' : '',
});

const structureMarker = async (entry: CollectionEntry<'strutture'>) => ({
  name: entry.data.name,
  kind: 'structure',
  lat: entry.data.coords.lat,
  lng: entry.data.coords.lng,
  page: `/strutture/${getSlug(entry.id)}`,
  book: entry.data.site,
  sub: entry.data.town,
  img: await bgUrl(entry.data.heroImage, POPUP_WIDTH),
  rp: 'routes',
});

// stesso ordine del prototipo: il premium per ultimo, così resta sopra nel DOM
const markers = await Promise.all([
  ...territories.filter((entry) => entry.data.tier !== 'premium').map(territoryMarker),
  ...structures.map(structureMarker),
  ...territories.filter((entry) => entry.data.tier === 'premium').map(territoryMarker),
]);
---

<div
  id="map-el"
  data-markers={JSON.stringify(markers)}
  data-center={JSON.stringify(site.map.center)}
  data-zoom={String(site.map.zoom)}
>
</div>

<script>
  import maplibregl from 'maplibre-gl';

  (function () {
    var container = document.getElementById('map-el');
    if (!container) return;

    var markers = JSON.parse(container.dataset.markers || '[]');
    var center = JSON.parse(container.dataset.center || '[10.68,42.98]');
    var zoom = Number(container.dataset.zoom || 9);
    var col: Record<string, string> = { premium: '#f5a623', territory: '#2e151c', structure: '#a80030' };

    var map = new maplibregl.Map({
      container: 'map-el',
      style: 'https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json',
      center: center,
      zoom: zoom,
      scrollZoom: false,
      attributionControl: { compact: true },
    });

    // issue #30: i marker non aspettano `load`. Sono elementi DOM sovrapposti al canvas,
    // non layer dello stile, quindi non hanno bisogno né di sprite né di glyph. Quando il
    // CDN di Carto degrada, `style.load` arriva ma `load` non scatta mai e nessun evento
    // `error` viene emesso: la mappa base si vede, i pin spariscono e la console è pulita.
    (function addMarkers() {
      var bounds = new maplibregl.LngLatBounds();

      markers.forEach(function (m: any) {
        var isPremium = m.kind === 'premium';
        var svgW = isPremium ? 38 : 26;
        var svgH = isPremium ? 50 : 34;
        var svgPin =
          '<svg xmlns="http://www.w3.org/2000/svg" width="' + svgW + '" height="' + svgH +
          '" viewBox="0 0 24 32" aria-hidden="true" focusable="false" style="display:block;filter:drop-shadow(0 ' +
          (isPremium ? '4px 14px' : '2px 8px') + ' rgba(0,0,0,' + (isPremium ? '.7' : '.55') +
          '))"><path d="M12 0C5.37 0 0 5.37 0 12c0 7.5 12 20 12 20s12-12.5 12-20C24 5.37 18.63 0 12 0z" fill="' +
          col[m.kind] + '" stroke="' + (isPremium ? '#fff' : 'rgba(255,255,255,.85)') + '" stroke-width="' +
          (isPremium ? '2' : '1') + '"/><circle cx="12" cy="11" r="' + (isPremium ? '5.5' : '4.5') +
          '" fill="rgba(255,255,255,' + (isPremium ? '.95' : '.9') + ')"/></svg>';

        var label =
          m.kind === 'structure'
            ? 'Official Bike-Friendly Stay'
            : m.kind === 'premium'
              ? 'Home of the Tuscany Trail'
              : 'Official territory';
        var ctaLabel = m.kind === 'structure' ? 'See the stay →' : 'Discover →';
        var routeLabel = m.kind === 'structure' ? 'See the route pack →' : 'See the routes →';
        var bookLabel = m.kind === 'structure' ? 'Book →' : 'Find accommodation →';

        // issue #12: marker focusabile da tastiera con label, non più un div con solo onclick
        var el = document.createElement('button');
        el.type = 'button';
        el.setAttribute('aria-label', m.name + ' — ' + label);
        el.style.cssText =
          'cursor:pointer;background:none;border:0;padding:0;line-height:0;display:block;width:' +
          svgW + 'px;height:' + svgH + 'px';
        el.innerHTML = isPremium
          ? '<div style="position:relative;width:' + svgW + 'px;height:' + svgH +
            'px"><div style="position:absolute;top:17px;left:19px;width:14px;height:14px;margin:-7px 0 0 -7px;border-radius:50%;background:#f5a623;animation:pinpulse 2.4s ease-out infinite"></div>' +
            svgPin + '</div>'
          : svgPin;

        var popup = new maplibregl.Popup({
          offset: isPremium ? 30 : 25,
          closeButton: true,
          closeOnClick: true,
          maxWidth: '260px',
          anchor: 'bottom',
        }).setHTML(
          '<div style="width:228px;font-family:inherit">' +
            (m.img
              ? '<div style="height:130px;background:url(' + m.img +
                ') center/cover no-repeat"></div>'
              : '') +
            '<div style="padding:14px 16px 16px">' +
            '<div style="font-size:.58rem;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:' +
            col[m.kind] + ';margin-bottom:5px">' + label + '</div>' +
            '<b style="font-size:1.02rem;display:block;margin:0 0 3px;color:#111;line-height:1.15">' + m.name + '</b>' +
            '<span style="color:#777;font-size:.8rem">' + m.sub + '</span>' +
            '<div style="margin-top:12px;display:flex;flex-direction:column;gap:7px">' +
            '<a href="' + m.page +
            '" style="display:block;background:#a80030;color:#fff;font-weight:700;font-size:.84rem;padding:11px 16px;border-radius:10px;text-decoration:none;text-align:center;letter-spacing:.01em">' +
            ctaLabel + '</a>' +
            (m.rp
              ? '<a href="' + m.page + '#' + m.rp +
                '" style="display:block;background:#f5a623;color:#1a1a1a;font-weight:700;font-size:.84rem;padding:11px 16px;border-radius:10px;text-decoration:none;text-align:center;letter-spacing:.01em">' +
                routeLabel + '</a>'
              : '') +
            (m.book
              ? '<a href="' + m.book +
                '" target="_blank" rel="noopener" style="display:block;background:#2e151c;color:#fff;font-weight:700;font-size:.84rem;padding:11px 16px;border-radius:10px;text-decoration:none;text-align:center;letter-spacing:.01em">' +
                bookLabel + '</a>'
              : '') +
            '</div></div></div>'
        );

        new maplibregl.Marker({ element: el, anchor: 'bottom' })
          .setLngLat([m.lng, m.lat])
          .setPopup(popup)
          .addTo(map);

        bounds.extend([m.lng, m.lat]);
      });

      map.fitBounds(bounds, { padding: { top: 320, bottom: 60, left: 100, right: 100 }, maxZoom: 9 });
    })();

    // Senza questo un fallimento dello stile resta invisibile: durante il disservizio
    // di #30 la mappa era degradata per dieci minuti e la console non diceva nulla.
    map.on('error', function (e: any) {
      console.error('[map] errore di caricamento dello stile', (e && e.error) || e);
    });
  })();
</script>
