---
// Banner di consenso per GA4 (issue #19, voce 8): Consent Mode v2 "advanced".
// gtag parte con tutto negato (vedi Base.astro); qui si raccoglie la scelta.
// La scelta vive in localStorage ('cit-consent') e il banner compare solo
// finché una scelta non c'è.
---

<div id="consent-banner" class="consent-banner" role="dialog" aria-label="Cookie consent" hidden>
  <p>
    We use Google Analytics to understand how the site is used — it only sets
    cookies if you accept. No ads, no profiling.
  </p>
  <div class="consent-actions">
    <button type="button" id="consent-accept" class="btn gold">Accept</button>
    <button type="button" id="consent-decline" class="btn dark">Decline</button>
  </div>
</div>

<style>
  .consent-banner {
    position: fixed;
    bottom: 16px;
    left: 16px;
    right: 16px;
    max-width: 560px;
    margin: 0 auto;
    background: #16281e;
    color: #f4efe6;
    padding: 16px 20px;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    z-index: 1000;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
  }
  .consent-banner p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.45;
    flex: 1 1 260px;
  }
  .consent-actions {
    display: flex;
    gap: 8px;
  }
</style>

<script>
  const KEY = 'cit-consent';
  const banner = document.getElementById('consent-banner');

  function choose(value: 'granted' | 'denied') {
    try {
      localStorage.setItem(KEY, value);
    } catch {
      /* storage pieno o bloccato: la scelta vale per la pagina corrente */
    }
    if (value === 'granted' && typeof (window as any).gtag === 'function') {
      (window as any).gtag('consent', 'update', { analytics_storage: 'granted' });
    }
    banner?.setAttribute('hidden', '');
  }

  let stored: string | null = null;
  try {
    stored = localStorage.getItem(KEY);
  } catch {
    /* localStorage inaccessibile: trattato come nessuna scelta */
  }

  if (banner && stored !== 'granted' && stored !== 'denied') {
    banner.removeAttribute('hidden');
    document.getElementById('consent-accept')?.addEventListener('click', () => choose('granted'));
    document.getElementById('consent-decline')?.addEventListener('click', () => choose('denied'));
  }
</script>
