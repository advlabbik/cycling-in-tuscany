---
/**
 * Viewer di itinerario — mappa + altimetria + POI, tutto dentro la pagina.
 * Logica portata dalla vista percorso di tg-guida (Leaflet) e riscritta su
 * MapLibre GL, che è la libreria già bundlata del sito (niente CDN, #45).
 * I dati arrivano da public/data/itinerari/<slug>.json, generati da
 * scripts/gen_poi.py (OSM via Overpass — vedi docs/generazione-poi.md di
 * tg-guida per le trappole). Modello POI identico a tg-guida:
 *   {t:'c'} centro raggruppato con conteggi ne/ns/nf,
 *   {t:'a'|'m'|'d'} punto singolo; lat/lng dove noti, altrimenti si aggancia
 *   al punto della traccia al proprio km (ed è scritto sotto il profilo).
 */
import 'maplibre-gl/dist/maplibre-gl.css';

interface Props {
  /** URL del JSON traccia+POI in public/ */
  src: string;
  /** colore della traccia (gravel oro scuro, road verde) */
  color: string;
}

const { src, color } = Astro.props;
---

<div class="rvw" data-src={src} data-color={color}>
  <div class="rvw-map" id="rvw-map"></div>
  <div class="rvw-filters" role="group" aria-label="Filter points of interest"></div>
  <div class="rvw-profwrap">
    <canvas class="rvw-prof"></canvas>
    <div class="rvw-pins"></div>
    <div class="rvw-tip" hidden></div>
  </div>
  <p class="rvw-note">Water and food stops are pinned at their km along the route — the mark says "around here", not "exactly here".</p>
  <div class="rvw-list"></div>
</div>

<style>
  .rvw{display:flex;flex-direction:column;gap:14px}
  .rvw-map{height:480px;border-radius:16px;overflow:hidden;border:1px solid var(--border);box-shadow:var(--shadow-md);transform:translateZ(0)}
  .rvw-filters{display:flex;gap:9px;flex-wrap:wrap}
  .rvw-profwrap{position:relative;height:200px;background:var(--surface);border:1px solid var(--border);border-radius:14px;box-shadow:var(--shadow-sm);touch-action:pan-y}
  .rvw-prof{position:absolute;inset:0;width:100%;height:100%;display:block}
  .rvw-pins{position:absolute;inset:0;pointer-events:none}
  .rvw-note{margin:0;font-size:.78rem;color:var(--muted)}
  .rvw-list{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
  @media(max-width:820px){.rvw-list{grid-template-columns:1fr}.rvw-map{height:380px}}
</style>

<style is:global>
  /* pin sul profilo: posizionati in px dal JS, quindi niente scoping Astro */
  .rvw-pin{position:absolute;transform:translate(-50%,-120%);width:26px;height:26px;border-radius:50%;border:2px solid #fff;display:flex;align-items:center;justify-content:center;cursor:pointer;pointer-events:auto;box-shadow:0 2px 8px rgba(0,0,0,.28);padding:0}
  .rvw-pin i.n,.rvw-mk i.n{position:absolute;top:-7px;right:-7px;background:#1a1a1a;color:#fff;font-style:normal;font-size:.6rem;font-weight:700;border-radius:999px;min-width:15px;height:15px;line-height:15px;text-align:center;padding:0 3px}
  .rvw-pin svg,.rvw-mk svg{display:block}
  .rvw-mk{position:relative;width:28px;height:28px;border-radius:50%;border:2px solid #fff;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 2px 10px rgba(0,0,0,.35)}
  .rvw-mk.partner{width:34px;height:34px;box-shadow:0 0 0 4px rgba(245,166,35,.35),0 2px 10px rgba(0,0,0,.35)}
  .rvw-tip{position:absolute;transform:translate(-50%,-100%);background:#1a1a1a;color:#fff;font-size:.76rem;padding:7px 10px;border-radius:8px;pointer-events:none;white-space:nowrap;z-index:5}
  .rvw-tip b{color:#f5a623}
  .rvw-fil{display:inline-flex;align-items:center;gap:7px;background:var(--surface);border:1.5px solid var(--border);border-radius:999px;padding:8px 15px;font-size:.82rem;font-weight:600;cursor:pointer;color:var(--fg);font-family:var(--font-body);transition:border-color .2s,background .2s}
  .rvw-fil.on{background:#1a1a1a;border-color:#1a1a1a;color:#fff}
  .rvw-poicard{display:flex;align-items:flex-start;gap:13px;background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:14px 16px;box-shadow:var(--shadow-sm)}
  .rvw-poicard.partner{border:1.5px solid #f5a623;box-shadow:0 4px 20px rgba(245,166,35,.18)}
  .rvw-poicard .ico{flex-shrink:0;width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin-top:2px}
  .rvw-poicard b{display:block;font-size:.95rem;line-height:1.25}
  .rvw-poicard .desc{font-size:.83rem;color:var(--muted);margin:3px 0 0;line-height:1.45}
  .rvw-poicard .kmtag{margin-left:auto;flex-shrink:0;font-family:'JetBrains Mono',monospace;font-size:.68rem;color:var(--muted);background:var(--cream);border-radius:6px;padding:3px 8px;white-space:nowrap}
  .rvw-poicard .ptag{display:inline-block;background:#f5a623;color:#1a1a1a;font-size:.6rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;border-radius:999px;padding:2px 9px;margin-bottom:5px}
  .rvw-poicard a.book{display:inline-block;margin-top:8px;background:var(--dark);color:#fff;font-weight:700;font-size:.76rem;padding:7px 14px;border-radius:8px;text-decoration:none}
  .rvw-map .maplibregl-popup-content{font-family:var(--font-body)}
</style>

<script>
  import maplibregl from 'maplibre-gl';

  const root = document.querySelector<HTMLElement>('.rvw');
  if (root)
    init(root).catch((err) => {
      /* senza questo, un JSON mancante uccideva il viewer in silenzio: box
         grigio vuoto e nessun messaggio (lo stesso buco che il fix #30 aveva
         chiuso sulla mappa della home) */
      console.error('[rvw] dati traccia non caricati: ' + ((err && (err as Error).stack) || err));
      const box = root.querySelector<HTMLElement>('.rvw-map');
      if (box)
        box.innerHTML =
          '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#6b6b6b;font-size:.92rem;padding:24px;text-align:center">The route map could not be loaded — please refresh the page.</div>';
    });

  async function init(root: HTMLElement) {
    const res = await fetch(root.dataset.src!);
    if (!res.ok) throw new Error(`HTTP ${res.status} su ${root.dataset.src}`);
    const data = await res.json();
    const color = root.dataset.color || '#b8860b';
    const pts: number[][] = data.points; // [lat, lng, ele, km]
    /* l'asse del profilo usa il km dell'ULTIMO punto della traccia, non il
       kmTot dichiarato: cosi' asse, cursore e pin condividono per costruzione
       la stessa scala qualunque cosa scriva il generatore */
    const kmTot: number = pts[pts.length - 1][3] || data.kmTot;
    const poi: any[] = data.poi;

    /* colori e icone per tipo — oro = partner/dormire, come il tier premium del sito */
    const TCOL: Record<string, string> = { a: '#1971c2', m: '#8a6d1c', b: '#a80030', c: '#2e151c', d: '#f5a623' };
    const TLAB: Record<string, string> = { a: 'Water', m: 'Food', b: 'Bike shops', c: 'Villages', d: 'Sleep' };
    const ICO: Record<string, string> = {
      a: '<path d="M12 2.7C9.2 6.5 6 10.2 6 13.5a6 6 0 0 0 12 0c0-3.3-3.2-7-6-10.8z"/>',
      m: '<path d="M7 3v7M5 3v4a2 2 0 0 0 4 0V3M15 3v18M15 12h3a1 1 0 0 0 1-1V7a4 4 0 0 0-4-4M7 12v9"/>',
      c: '<path d="M4 21h16M5 21V10l7-6 7 6v11M9 21v-6h6v6"/>',
      d: '<path d="M3 18v-6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v6M3 18h18M7 10V7h4v3"/>',
      b: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.77z"/>',
    };
    const icon = (t: string, size: number, stroke = '#fff') =>
      `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="${stroke}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${ICO[t]}</svg>`;
    const esc = (s: string) => String(s || '').replace(/[<>&"]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' }[c]!));
    /* gli URL dei POI arrivano dal JSON: si accettano solo http(s) e si
       escapano comunque — un url malevolo non deve poter uscire dall'href */
    const safeUrl = (u: any) => (/^https?:\/\//.test(String(u || '')) ? esc(String(u)) : '');
    const cap = (s: string) => (s ? s[0].toUpperCase() + s.slice(1) : '');
    /* il blocco "quanti posti per mangiare / dormire / fontane" di un centro */
    const counts = (e: any) =>
      [e.ne ? `${e.ne} places to eat` : null, e.ns ? `${e.ns} stays` : null, e.nf ? `${e.nf} fountains` : null]
        .filter(Boolean)
        .join(' · ');
    const descOf = (e: any) =>
      e.desc ||
      (e.t === 'c'
        ? counts(e)
        : e.t === 'a'
          ? [e.n > 1 ? `${e.n} fountains within a short stretch` : 'Fountain', e.luogo].filter(Boolean).join(' · ')
          : [cap(e.sub), e.luogo].filter(Boolean).join(' · '));
    const nameOf = (e: any) =>
      e.t === 'a' && e.n > 1 ? `Fountains ×${e.n}` : e.name || cap(e.sub) || TLAB[e.t];
    /* un centro raggruppato risponde anche ai filtri delle sue categorie */
    const poiMatch = (e: any, f: string) =>
      f === 'all' || e.t === f ||
      (e.t === 'c' && ((f === 'm' && e.ne) || (f === 'd' && e.ns) || (f === 'a' && e.nf)));

    const idxFromKm = (km: number) => {
      let lo = 0, hi = pts.length - 1;
      while (lo < hi) { const mid = (lo + hi) >> 1; if (pts[mid][3] < km) lo = mid + 1; else hi = mid; }
      return lo;
    };
    /* come tg-guida: coordinate vere se note, altrimenti punto della traccia al km */
    const posOf = (e: any): [number, number] =>
      e.lat != null ? [e.lat, e.lng] : [pts[idxFromKm(e.km)][0], pts[idxFromKm(e.km)][1]];

    /* ---------- mappa ---------- */
    const map = new maplibregl.Map({
      container: root.querySelector<HTMLElement>('.rvw-map')!,
      style: 'https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json',
      center: [pts[0][1], pts[0][0]],
      zoom: 10,
      scrollZoom: false,
      attributionControl: { compact: true },
    });
    map.addControl(new maplibregl.NavigationControl({ showCompass: false }));
    /* i browser in-app (anteprime social, webview) cambiano l'altezza del
       viewport dopo l'init: senza resize() la proiezione dei marker scivola
       e i segni finiscono "in mare" in colonna */
    new ResizeObserver(() => map.resize()).observe(root.querySelector<HTMLElement>('.rvw-map')!);
    map.on('error', (e: any) => console.error('[rvw] errore stile mappa', (e && e.error) || e));

    const bounds = pts.reduce(
      (b, p) => b.extend([p[1], p[0]]),
      new maplibregl.LngLatBounds([pts[0][1], pts[0][0]], [pts[0][1], pts[0][0]]),
    );
    const fitAll = (animate = false) => map.fitBounds(bounds, { padding: 44, animate, maxZoom: 13 });
    fitAll();

    const line = { type: 'Feature', geometry: { type: 'LineString', coordinates: pts.map((p) => [p[1], p[0]]) } };
    map.on('load', () => {
      map.addSource('route', { type: 'geojson', data: line as any });
      map.addLayer({ id: 'route-casing', type: 'line', source: 'route', paint: { 'line-color': '#fff', 'line-width': 8, 'line-opacity': 0.9 }, layout: { 'line-cap': 'round', 'line-join': 'round' } });
      map.addLayer({ id: 'route-line', type: 'line', source: 'route', paint: { 'line-color': color, 'line-width': 4.5 }, layout: { 'line-cap': 'round', 'line-join': 'round' } });
      /* l'inquadratura si rifà a stile carico e dimensioni definitive: senza
         questo, se il contenitore cambia misura durante il caricamento la
         mappa resta inquadrata su un pezzo solo del percorso */
      map.resize();
      fitAll();
    });

    /* partenza/arrivo (anello: coincidono) */
    const startEl = document.createElement('div');
    startEl.className = 'rvw-mk';
    startEl.style.background = color;
    startEl.innerHTML = `<svg width="13" height="13" viewBox="0 0 24 24" fill="#fff"><circle cx="12" cy="12" r="6"/></svg>`;
    new maplibregl.Marker({ element: startEl })
      .setLngLat([pts[0][1], pts[0][0]])
      .setPopup(new maplibregl.Popup({ offset: 18 }).setHTML('<div style="padding:10px 12px;font-weight:700">Start & finish</div>'))
      .addTo(map);

    /* POI sulla mappa, raggruppati se cadono quasi sullo stesso punto */
    type MapGroup = { members: any[]; lat: number; lng: number; marker?: maplibregl.Marker; el?: HTMLElement };
    const groupsMap: MapGroup[] = [];
    /* il partner ha SEMPRE il suo marker, mai in un gruppo: raggruppato coi
       servizi di zona il segno diventava un "10" dorato che sembrava una
       lista di alloggi (15/8) */
    poi.filter((e) => !e.partner).forEach((e) => {
      const [lat, lng] = posOf(e);
      const near = groupsMap.find((g) => Math.abs(g.lat - lat) < 0.004 && Math.abs(g.lng - lng) < 0.004);
      if (near) near.members.push(e);
      else groupsMap.push({ members: [e], lat, lng });
    });
    poi.filter((e) => e.partner).forEach((e) => {
      const [lat, lng] = posOf(e);
      groupsMap.push({ members: [e], lat, lng });
    });
    const popupHtml = (members: any[]) =>
      '<div style="padding:12px 14px;min-width:190px;max-height:260px;overflow-y:auto">' +
      members
        .map(
          (e) =>
            `<div style="margin-bottom:9px"><span style="font-size:.58rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:${TCOL[e.t]}">${e.t === 'c' ? 'Village' : TLAB[e.t]} · km ${e.km}</span>` +
            `<b style="display:block;font-size:.92rem;color:#111">${esc(nameOf(e))}</b>` +
            `<span style="font-size:.78rem;color:#666">${esc(descOf(e))}</span>` +
            (e.partner && safeUrl(e.url)
              ? `<a href="${safeUrl(e.url)}" target="_blank" rel="noopener" style="display:block;margin-top:7px;background:#f5a623;color:#1a1a1a;font-weight:700;font-size:.78rem;padding:8px 12px;border-radius:8px;text-decoration:none;text-align:center">Book ${esc(e.name)} →</a>`
              : '') +
            '</div>'
        )
        .join('') +
      '</div>';
    groupsMap.forEach((g) => {
      const capo = g.members.find((e) => e.partner) || g.members.find((e) => e.t === 'c') || g.members[0];
      const el = document.createElement('button');
      el.type = 'button';
      el.className = 'rvw-mk' + (capo.partner ? ' partner' : '');
      el.style.background = TCOL[capo.t];
      el.style.border = '2px solid #fff';
      el.innerHTML = icon(capo.t, 14) + (g.members.length > 1 ? `<i class="n">${g.members.length}</i>` : '');
      g.el = el;
      g.marker = new maplibregl.Marker({ element: el })
        .setLngLat([g.lng, g.lat])
        .setPopup(new maplibregl.Popup({ offset: 20, maxWidth: '260px' }).setHTML(popupHtml(g.members)))
        .addTo(map);
      // MapLibre sovrascrive l'aria-label con "Map marker": si rimette dopo l'addTo
      el.setAttribute('aria-label', g.members.map((e) => nameOf(e)).join(', '));
    });
    (root as any)._rvwMap = map; // per la verifica in test: bounds/zoom dall'esterno
    /* il filtro comanda anche i segni sulla mappa, non solo profilo e lista */
    function refreshMapMarkers() {
      groupsMap.forEach((g) => {
        const visibili = g.members.filter((e) => poiMatch(e, filter));
        g.el!.style.display = visibili.length ? 'flex' : 'none';
        const capo = visibili.find((e) => e.partner) || visibili.find((e) => e.t === 'c') || visibili[0];
        if (capo) {
          g.el!.className = 'rvw-mk' + (capo.partner ? ' partner' : '');
          g.el!.style.background = TCOL[capo.t];
          g.el!.innerHTML = icon(capo.t, 14) + (visibili.length > 1 ? `<i class="n">${visibili.length}</i>` : '');
          g.el!.setAttribute('aria-label', visibili.map((e) => nameOf(e)).join(', '));
          // il fumetto deve raccontare solo i membri visibili col filtro attivo
          g.marker!.getPopup()?.setHTML(popupHtml(visibili));
        } else if (g.marker!.getPopup()?.isOpen()) {
          g.marker!.togglePopup(); // gruppo filtrato via: niente fumetti orfani
        }
      });
    }

    /* cursore che segue il profilo */
    const curEl = document.createElement('div');
    curEl.style.cssText = 'width:15px;height:15px;border-radius:50%;background:#1971c2;border:2.5px solid #fff;box-shadow:0 1px 6px rgba(0,0,0,.4)';
    const cursor = new maplibregl.Marker({ element: curEl });
    let cursorOn = false;
    const showCursor = (i: number) => {
      cursor.setLngLat([pts[i][1], pts[i][0]]);
      if (!cursorOn) { cursor.addTo(map); cursorOn = true; }
    };
    const hideCursor = () => { if (cursorOn) { cursor.remove(); cursorOn = false; } tip.hidden = true; drawProfile(); };

    /* ---------- profilo altimetrico (canvas, come tg-guida) ---------- */
    const wrap = root.querySelector<HTMLElement>('.rvw-profwrap')!;
    const cv = root.querySelector<HTMLCanvasElement>('.rvw-prof')!;
    const pins = root.querySelector<HTMLElement>('.rvw-pins')!;
    const tip = root.querySelector<HTMLElement>('.rvw-tip')!;
    let W = 0, H = 0;
    /* min/max quota calcolati UNA volta: prima si riscannerizzavano tutti i
       ~1500 punti a ogni mousemove sul profilo */
    let lo = Infinity, hi = -Infinity;
    for (const p of pts) { if (p[2] < lo) lo = p[2]; if (p[2] > hi) hi = p[2]; }
    const pad = Math.max((hi - lo) * 0.12, 20);
    const emin = Math.floor((lo - pad) / 50) * 50;
    const emax = Math.ceil((hi + pad) / 50) * 50;
    const X = (km: number) => 46 + (W - 46 - 14) * (km / kmTot);
    const Y = (e: number) => 12 + (H - 12 - 24) * (1 - (e - emin) / (emax - emin || 1));
    const kmFromX = (x: number) => Math.max(0, Math.min(1, (x - 46) / (W - 46 - 14 || 1))) * kmTot;
    let selKm: number | null = null;
    let filter = 'all';

    function drawProfile() {
      W = wrap.clientWidth; H = wrap.clientHeight;
      if (!W) return;
      const dpr = window.devicePixelRatio || 1;
      cv.width = W * dpr; cv.height = H * dpr;
      const ctx = cv.getContext('2d')!;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      ctx.font = '10.5px "DM Sans", sans-serif';
      const estep = emax - emin > 300 ? 100 : 50;
      for (let e = Math.ceil(emin / estep) * estep; e <= emax; e += estep) {
        const y = Y(e);
        ctx.strokeStyle = '#eee7db'; ctx.beginPath(); ctx.moveTo(46, y); ctx.lineTo(W - 14, y); ctx.stroke();
        ctx.fillStyle = '#9a938a'; ctx.textAlign = 'right'; ctx.fillText(e + ' m', 42, y + 3.5);
      }
      const kstep = kmTot > 60 ? 10 : 5;
      for (let km = kstep; km < kmTot; km += kstep) {
        const x = X(km);
        ctx.strokeStyle = '#f4efe6'; ctx.beginPath(); ctx.moveTo(x, 12); ctx.lineTo(x, H - 24); ctx.stroke();
        ctx.fillStyle = '#9a938a'; ctx.textAlign = 'center'; ctx.fillText(String(km), x, H - 8);
      }
      ctx.fillStyle = '#9a938a'; ctx.textAlign = 'right'; ctx.fillText('km', W - 14, H - 8);
      ctx.save();
      ctx.beginPath(); ctx.rect(46, 0, W - 46 - 14, H); ctx.clip();
      const path = () => {
        ctx.beginPath(); ctx.moveTo(X(pts[0][3]), Y(pts[0][2]));
        for (let i = 1; i < pts.length; i++) ctx.lineTo(X(pts[i][3]), Y(pts[i][2]));
      };
      path();
      ctx.lineTo(X(kmTot), H - 24); ctx.lineTo(X(0), H - 24); ctx.closePath();
      const grad = ctx.createLinearGradient(0, 12, 0, H - 24);
      grad.addColorStop(0, color + '55'); grad.addColorStop(1, color + '0d');
      ctx.fillStyle = grad; ctx.fill();
      path();
      ctx.strokeStyle = color; ctx.lineWidth = 1.8; ctx.stroke();
      ctx.restore();
      if (selKm != null) {
        const i = idxFromKm(selKm);
        const x = X(pts[i][3]), y = Y(pts[i][2]);
        ctx.strokeStyle = '#1f1216'; ctx.setLineDash([4, 3]);
        ctx.beginPath(); ctx.moveTo(x, 12); ctx.lineTo(x, H - 24); ctx.stroke(); ctx.setLineDash([]);
        ctx.beginPath(); ctx.arc(x, y, 5, 0, 7); ctx.fillStyle = '#1971c2'; ctx.fill();
        ctx.strokeStyle = '#fff'; ctx.lineWidth = 2; ctx.stroke();
      }
      /* niente drawPins() qui: i pin dipendono solo da filtro e misura del
         contenitore. Rifarli a ogni mousemove distruggeva i bottoni sotto il
         cursore (click mangiati) e sprecava DOM churn a 60+ Hz */
    }

    /* ordine sui pin: prima i centri (riassumono una zona), o la categoria
       filtrata — come ordinePoi di tg-guida */
    const ordine = (f: string) => {
      const pri: Record<string, number> = f === 'all' ? { c: 0, b: 1, a: 2, m: 3, d: 4 } : { [f]: 0, b: 1, c: 2 };
      const rank = (e: any) => (pri[e.t] != null ? pri[e.t] : 2);
      return (a: any, b: any) => rank(a) - rank(b) || a.km - b.km;
    };

    /* pin sul profilo alla quota del loro km, raggruppati se si sovrappongono */
    function drawPins() {
      const inFilter = poi.filter((e) => poiMatch(e, filter));
      const groups: { x: number; y: number; members: any[] }[] = [];
      inFilter
        .slice()
        .sort(ordine(filter))
        .forEach((e) => {
          const x = X(e.km), y = Y(pts[idxFromKm(e.km)][2]);
          const near = groups.find((g) => Math.abs(g.x - x) < 24);
          if (near) near.members.push(e);
          else groups.push({ x, y, members: [e] });
        });
      pins.innerHTML = groups
        .map((g, i) => {
          const capo = g.members.find((e) => e.partner) || g.members[0];
          return `<button type="button" class="rvw-pin" data-g="${i}" style="left:${g.x}px;top:${g.y}px;background:${TCOL[capo.t]}" aria-label="${esc(g.members.map((e) => nameOf(e)).join(', '))}">${icon(capo.t, 13)}${g.members.length > 1 ? `<i class="n">${g.members.length}</i>` : ''}</button>`;
        })
        .join('');
      pins.querySelectorAll<HTMLElement>('.rvw-pin').forEach((b) =>
        b.addEventListener('click', (ev) => {
          ev.stopPropagation();
          const g = groups[+b.dataset.g!];
          /* stesso capo del disegno (partner prima): un pin dorato del partner
             deve volare dal partner, non dalla fontana entrata nel gruppo */
          const capo = g.members.find((e) => e.partner) || g.members[0];
          const [lat, lng] = posOf(capo);
          selKm = capo.km;
          showCursor(idxFromKm(capo.km));
          map.flyTo({ center: [lng, lat], zoom: Math.max(map.getZoom(), 12) });
          showTip(capo.km, g.members.map((e) => nameOf(e)).slice(0, 3).join(' · ') + (g.members.length > 3 ? '…' : ''));
          drawProfile();
        })
      );
    }

    function showTip(km: number, label?: string) {
      const i = idxFromKm(km);
      const x = Math.min(Math.max(X(km), 60), W - 60);
      const y = Math.max(Y(pts[i][2]), 56);
      tip.style.left = x + 'px';
      tip.style.top = y + 'px';
      tip.innerHTML = label ? `<b>km ${km.toFixed(1)}</b> · ${esc(label)}` : `<b>km ${km.toFixed(1)}</b> · ${pts[i][2]} m`;
      tip.hidden = false;
    }

    /* tocco/hover sul profilo → cursore sulla mappa + tooltip, coalescato a
       un ridisegno per frame via requestAnimationFrame */
    let movePending = false;
    let moveX = 0;
    const onMove = (clientX: number) => {
      moveX = clientX;
      if (movePending) return;
      movePending = true;
      requestAnimationFrame(() => {
        movePending = false;
        const r = wrap.getBoundingClientRect();
        const km = kmFromX(moveX - r.left);
        selKm = km;
        showCursor(idxFromKm(km));
        showTip(km);
        drawProfile();
      });
    };
    wrap.addEventListener('mousemove', (e) => onMove(e.clientX));
    wrap.addEventListener('mouseleave', () => { selKm = null; hideCursor(); });
    wrap.addEventListener('touchmove', (e) => onMove(e.touches[0].clientX), { passive: true });
    /* senza questi due, su telefono tooltip e cursore restavano appiccicati
       per sempre dopo il primo scrub (mouseleave non arriva mai col touch) */
    wrap.addEventListener('touchend', () => { selKm = null; hideCursor(); });
    wrap.addEventListener('touchcancel', () => { selKm = null; hideCursor(); });

    /* filtri — mostra solo le categorie davvero presenti nei dati */
    const has = (t: string) => poi.some((e) => poiMatch(e, t));
    const filWrap = root.querySelector<HTMLElement>('.rvw-filters')!;
    filWrap.innerHTML =
      `<button type="button" class="rvw-fil on" aria-pressed="true" data-f="all">All</button>` +
      ['a', 'm', 'b', 'c', 'd'].filter(has).map((t) => `<button type="button" class="rvw-fil" aria-pressed="false" data-f="${t}">${icon(t, 14, TCOL[t])} ${TLAB[t]}</button>`).join('');
    filWrap.querySelectorAll<HTMLElement>('.rvw-fil').forEach((b) =>
      b.addEventListener('click', () => {
        filter = b.dataset.f!;
        filWrap.querySelectorAll('.rvw-fil').forEach((x) => {
          x.classList.toggle('on', x === b);
          x.setAttribute('aria-pressed', String(x === b));
        });
        renderList();
        refreshMapMarkers();
        drawProfile();
        drawPins();
      })
    );

    /* lista POI sotto il profilo */
    const list = root.querySelector<HTMLElement>('.rvw-list')!;
    function renderList() {
      const inFilter = poi.filter((e) => poiMatch(e, filter)).slice().sort((a, b) => a.km - b.km);
      list.innerHTML = inFilter
        .map(
          (e) =>
            `<div class="rvw-poicard${e.partner ? ' partner' : ''}">` +
            `<span class="ico" style="background:${TCOL[e.t]}">${icon(e.t, 15)}</span>` +
            `<span>${e.partner ? '<span class="ptag">Official Bike-Friendly Stay</span>' : ''}<b>${esc(nameOf(e))}</b><span class="desc">${esc(descOf(e))}</span>` +
            (e.partner && safeUrl(e.url) ? `<a class="book" href="${safeUrl(e.url)}" target="_blank" rel="noopener">Book your base →</a>` : '') +
            `</span><span class="kmtag">km ${e.km}</span></div>`
        )
        .join('');
    }
    renderList();

    new ResizeObserver(() => { drawProfile(); drawPins(); }).observe(wrap);
    drawProfile();
    drawPins();
  }
</script>
