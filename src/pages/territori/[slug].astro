---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import RouteCard from '../../components/RouteCard.astro';
import { site } from '../../../site.config';
import { bgUrl } from '../../lib/images';

export async function getStaticPaths() {
  const territori = await getCollection('territori');
  return territori.map((territorio) => ({
    params: { slug: territorio.id.replace(/\.md$/, '') },
    props: { territorio },
  }));
}

const { territorio } = Astro.props;
const { Content } = await render(territorio);

const stay22Url = `https://www.stay22.com/allez/roam?aid=${site.stay22Aid}&campaign=${site.stay22Campaign}&lat=${territorio.data.coords.lat}&lng=${territorio.data.coords.lng}&product_medium=apps`;

/* Mappa Stay22 in testa alla pagina — stesso embed e stesso AID della guida
   Trentino (adventurelabsrl, quello agganciato alle commissioni), formato
   /embed/gm come in tg-guida. Campagna per territorio per l'attribuzione. */
const s22 = territorio.data.stay22Map;
const s22EmbedUrl = s22
  ? `https://www.stay22.com/embed/gm?aid=adventurelabsrl&campaign=${s22.campaign}&lat=${s22.lat}&lng=${s22.lng}` +
    `&maincolor=C74634&venue=${encodeURIComponent(s22.venue)}&ljs=en&mapstyle=outdoors`
  : null;
// Sfondo a tutta pagina, quindi 1600px: sotto c'è comunque un gradiente scuro (#42).
const heroImage = await bgUrl(territorio.data.heroImage, 1600);
const premium = territorio.data.tier === 'premium';
const magazine = territorio.data.magazine;
// non tutti i territori hanno l'articolo nel body: senza questo controllo
// `.editorial` renderizzerebbe un riquadro bianco vuoto (es. Campiglia)
const hasArticle = Boolean(territorio.body?.trim());

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TouristDestination',
  name: territorio.data.name,
  description: territorio.data.intro,
  address: { '@type': 'PostalAddress', addressRegion: territorio.data.area, addressCountry: 'IT' },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: territorio.data.coords.lat,
    longitude: territorio.data.coords.lng,
  },
  ...(heroImage ? { image: new URL(heroImage, Astro.site ?? Astro.url.origin).href } : {}),
};
---

<Base title={`${territorio.data.name} — Cycling in Tuscany`} description={territorio.data.intro} schema={schema} ogImage={territorio.data.heroImage}>
  <div
    class={premium ? 'hero premium' : 'hero'}
    style={heroImage
      ? `background-image:linear-gradient(rgba(20,10,15,.45),rgba(20,10,15,.72)),url(${heroImage});background-size:cover;background-position:center`
      : undefined}
  >
    <div class="wrap">
      {premium
        ? <div class="ribbon">★ {territorio.data.tagline}</div>
        : <div class="ribbon std">Official territory</div>}
      <div class="kick">Territory · {territorio.data.area}</div>
      <h1>{territorio.data.name}</h1>
      <p class="lead">{territorio.data.intro}</p>
    </div>
  </div>

  {s22 && s22EmbedUrl && (
    <section id="sleep">
      <div class="wrap">
        {s22.badge && <div class="ribbon" style="margin-bottom:10px">{s22.badge}</div>}
        <h2 class="sec">{s22.title}</h2>
        <p class="sub">{s22.text}</p>
        <div class="s22card">
          <iframe
            src={s22EmbedUrl}
            title={`Book your stay — ${territorio.data.name}`}
            allow="geolocation"
            loading="lazy"
          ></iframe>
        </div>
        <div class="s22links">
          <span class="muted small">Everything on the map is bookable.</span>
          <a class="chip" href={s22.airbnbUrl} target="_blank" rel="noopener">Prefer Airbnb? Search here →</a>
        </div>
      </div>
    </section>
  )}

  <section style={s22 ? 'background:#fff' : undefined}>
    <div class="wrap">
      <h2 class="sec">What to see</h2>
      <p class="sub">{territorio.data.itinerariTxt}</p>
      <div class="grid g3">
        {territorio.data.cosaVedere.map((item) => (
          <div class="cvcard">
            {/* `<Image>` e non `<img src={item.image.src}>`: solo così la foto passa
                davvero dalla pipeline, e width/height intrinseci tolgono il layout
                shift (#42). 700px = la colonna della griglia `.g3` (~340px) al 2x. */}
            <div class="cvcard-img">
              {item.image ? (
                <Image src={item.image} alt={item.titolo} width={700} format="webp" loading="lazy" />
              ) : (
                <div class="cvcard-img-placeholder">
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2" stroke="#666" stroke-width="1.5" />
                    <circle cx="8.5" cy="8.5" r="1.5" fill="#666" />
                    <path d="M21 15l-5-5L5 21" stroke="#666" stroke-width="1.5" stroke-linecap="round" />
                  </svg>
                </div>
              )}
            </div>
            <div class="cvcard-body">
              <h3>{item.titolo}</h3>
              <p set:html={item.descrizione}></p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {territorio.data.ridePack?.length ? (
    <section id="routes" style="background:#fff">
      <div class="wrap">
        <h2 class="sec">Official routes</h2>
        <p class="sub">Four loops ready to download — open the track in Ride with GPS and ride.</p>
        <div class="grid g2">
          {territorio.data.ridePack.map((route) => <RouteCard route={route} />)}
        </div>
      </div>
    </section>
  ) : null}

  {magazine && (
    <section id="magazine">
      <div class="wrap">
        <h2 class="sec">{magazine.heroTitle}</h2>
        <p class="sub">From the Cycling in Tuscany Magazine.</p>
        {hasArticle && (
          <div class="editorial">
            <Content />
          </div>
        )}
        {magazine.boxes.length > 0 && (
          <div class="grid g2" style="margin-top:22px">
            {magazine.boxes.map((box) => (
              <div class="card">
                <h3>{box.titolo}</h3>
                <p>{box.testo}</p>
              </div>
            ))}
          </div>
        )}
        {magazine.fonte && <p class="muted small" style="margin-top:18px">{magazine.fonte}</p>}
      </div>
    </section>
  )}

  <section style="background:#fff">
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h3>Stay near {territorio.data.name}</h3>
          <p>Book from verified bike-friendly stays in the area — tracked by Cycling in Tuscany.</p>
        </div>
        <a class="btn gold" href={stay22Url} target="_blank" rel="noopener">Find accommodation →</a>
      </div>

      <div class="grid g2" style="margin-top:22px">
        <div class="card">
          <h3>Useful links</h3>
          <div class="chips" style="margin-top:8px">
            {territorio.data.channels.length > 0 ? (
              territorio.data.channels.map((channel) => (
                <a class="chip" href={channel.url} target="_blank" rel="noopener">{channel.label} →</a>
              ))
            ) : (
              <span class="muted small">—</span>
            )}
          </div>
        </div>
        <div class="card">
          <h3>Contacts & materials</h3>
          <ul style="margin:8px 0 14px;padding-left:18px">
            {territorio.data.numeriUtili.length > 0 ? (
              territorio.data.numeriUtili.map((item) => (
                <li><b>{item.label}:</b> {item.value}</li>
              ))
            ) : (
              <li class="muted">—</li>
            )}
          </ul>
          <a class="pack-dl-btn" href={territorio.data.guidaPdf} target="_blank">
            <span class="pack-dl-circle">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="7 10 12 15 17 10" />
                <line x1="12" y1="15" x2="12" y2="3" />
              </svg>
            </span>
            {premium ? 'Download the complete guide (PDF)' : 'Download the Ride Base Pack (PDF)'}
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .s22card{border-radius:16px;overflow:hidden;border:1px solid var(--border);box-shadow:var(--shadow-md);background:var(--surface);transform:translateZ(0)}
  .s22card iframe{display:block;width:100%;height:480px;border:0}
  .s22links{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:12px}
  @media(max-width:820px){.s22card iframe{height:420px}}
</style>
