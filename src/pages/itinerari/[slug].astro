---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RouteViewer from '../../components/RouteViewer.astro';
import Stay22MapSection from '../../components/Stay22MapSection.astro';
import { bgUrl } from '../../lib/images';

export async function getStaticPaths() {
  const itinerari = await getCollection('itinerari');
  return itinerari.map((itinerario) => ({
    params: { slug: itinerario.id.replace(/\.md$/, '') },
    props: { itinerario },
  }));
}

const { itinerario } = Astro.props;
const d = itinerario.data;

const routeColor = d.type === 'Gravel' ? '#b8860b' : '#a80030';
/* Stay22 centrato sulla zona dell'anello, con campagna dedicata all'itinerario:
   è la campagna che rende attribuibile ogni prenotazione nel CSV di Stay22. */
/* La mappa alloggi mostra la TRACCIA e gli hotel sopra, dentro la pagina:
   il vecchio link /allez/roam era un redirect e sbatteva fuori su Booking o
   Expedia a caso (Andrea, 18/8). Stay22 scarica il GPX dai suoi server,
   quindi serve un URL assoluto. */
const gpxAbs = new URL(d.gpx, Astro.site ?? Astro.url.origin).href;
/* UTM sul link di prenotazione del partner: cosi' l'albergatore vede nel suo
   Analytics quanto traffico gli manda il progetto — l'argomento del rinnovo */
const bookUtm = (url: string) =>
  url + (url.includes('?') ? '&' : '?') + 'utm_source=tuscanytrail365&utm_medium=referral&utm_campaign=' + itinerario.id.replace(/\.md$/, '');
const heroImage = await bgUrl(d.heroImage, 1600);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SportsActivityLocation',
  name: `${d.name} — ${d.type} route`,
  description: d.intro,
  address: { '@type': 'PostalAddress', addressRegion: 'Tuscany', addressCountry: 'IT' },
};
---

<Base title={`${d.name} — ${d.type} route · Tuscany Trail 365`} description={d.intro} schema={schema} ogImage={d.heroImage} maplibre={true}>
  <div
    class="hero"
    style={heroImage
      ? `background-image:linear-gradient(rgba(20,10,15,.5),rgba(20,10,15,.75)),url(${heroImage});background-size:cover;background-position:center`
      : undefined}
  >
    <div class="wrap">
      <a class="badge-verif" href="https://www.tuscanytrail.it" target="_blank" rel="noopener" style="text-decoration:none">✔ Verified route · by the people behind the Tuscany Trail →</a>
      <div class="kick">{d.type} itinerary · {d.area}</div>
      <h1>{d.name}</h1>
      <p class="lead">{d.tagline}</p>
      <div class="it-stats">
        <span><b>{d.km} km</b></span>
        <span><b>{d.dislivello}</b> D+</span>
        <span>{d.time}</span>
        <span>{d.diff}</span>
        <span>{d.surface}</span>
      </div>
    </div>
  </div>

  <section id="study">
    <div class="wrap">
      <h2 class="sec">Study the route</h2>
      <p class="sub">
        Map, elevation and everything you'll find along the way. Touch the profile to follow the
        route on the map, tap a pin for details.
      </p>
      <RouteViewer src={d.trackData} color={routeColor} />
    </div>
  </section>

  <section style="background:#fff">
    <div class="wrap">
      <h2 class="sec">Highlights</h2>
      <p class="sub">What makes this loop worth riding.</p>
      <div class="chips">
        {d.highlights.map((h) => <span class="chip">{h}</span>)}
      </div>
    </div>
  </section>

  <section id="goodtoknow">
    <div class="wrap">
      <h2 class="sec">Good to know</h2>
      <p class="sub">Everything from the Ride Base Pack, right here on the page.</p>
      <div class="grid g2">
        {d.goodToKnow.map((g) => (
          <div class="card">
            <h3>{g.label}</h3>
            <p>{g.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {d.base && (
    <section id="sleep" style="background:#fff">
      <div class="wrap">
        <h2 class="sec">Your base for this loop</h2>
        <p class="sub">
          This route belongs to an Official Bike-Friendly Stay — the loop starts and ends right
          at its door.
        </p>
        <div class="cta-band">
          <div>
            <h3>{d.base.name} — your base for this loop</h3>
            <p>Bike storage, bike wash, early breakfast and local route knowledge. Verified by the Tuscany Trail.</p>
          </div>
          <div style="display:flex;gap:10px;flex-wrap:wrap">
            <a class="btn gold" href={bookUtm(d.base.site)} target="_blank" rel="noopener">Book {d.base.name} →</a>
            <a class="btn dark" href={`/strutture/${d.base.slug}`}>See the stay</a>
          </div>
        </div>
      </div>
    </section>
  )}

  {!d.base && (
    <Stay22MapSection
      id="sleep"
      white={true}
      lat={d.stay22Center.lat}
      lng={d.stay22Center.lng}
      venue={d.name}
      campaign={d.stay22Campaign}
      title="Sleep along this route"
      text="The whole loop is drawn on the map. Move it along the track to find a place to stay wherever you want to break the ride — hotels, B&Bs and campgrounds, all bookable from here."
      gpx={gpxAbs}
      gpxColor={routeColor.replace('#', '')}
      note="Everything on the map is bookable, without leaving this page."
    >
      {d.territory && (
        <div class="cta-band" style="margin-top:22px">
          <div>
            <h3>An Official Territory route</h3>
            <p>This loop belongs to {d.territory.name}, official territory of Tuscany Trail 365.</p>
          </div>
          <a class="btn gold" href={`/territori/${d.territory.slug}`}>Discover {d.territory.name} →</a>
        </div>
      )}
    </Stay22MapSection>
  )}

  <section id="gpx">
    <div class="wrap">
      <div class="pack-dl-bar">
        <div class="pack-dl-bar-glow"></div>
        <div class="pack-dl-bar-left">
          <div class="pack-dl-label">GPX track · free</div>
          <h3 class="pack-dl-title">Take this route with you</h3>
          <p class="it-gatehint">Leave your email and we'll send you the GPX file, ready for your bike computer.</p>
        </div>
        <div class="pack-dl-bar-right">
          {/* method="post": se lo script muore prima di agganciare il submit,
              il browser NON deve fare un GET con l'email in chiaro nell'URL */}
          <form id="gpx-gate" class="it-gate" method="post" novalidate data-area={d.area} data-type={d.type} data-diff={d.diff} data-gpx={d.gpx} data-name={d.name} data-rwgps={d.rwgpsUrl || ''}>
            <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;height:0;width:0;overflow:hidden" />
            <input type="email" name="email" placeholder="you@email.com" required aria-label="Email address" />
            <button type="submit" class="pack-dl-btn" style="border:0;cursor:pointer">
              <span class="pack-dl-circle">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                  <polyline points="7 10 12 15 17 10" />
                  <line x1="12" y1="15" x2="12" y2="3" />
                </svg>
              </span>
              <span id="gpx-btn-label">Get the GPX</span>
            </button>
            <label class="it-consent">
              <input type="checkbox" name="consent" />
              <span>Send me new verified routes and Tuscany riding tips (a few emails a year, no spam)</span>
            </label>
            <p id="gpx-err" class="it-err" hidden>Something went wrong on our side — give it another try in a minute.</p>
          </form>
          <div id="gpx-sent" class="it-sent" hidden>
            <p><b>The GPX is on its way.</b> Check the inbox of <span id="gpx-sent-email"></span> — the file arrives attached, from hello@tuscanytrail.it. No email in a few minutes? Have a look in spam.</p>
          </div>
        </div>
      </div>
      <p class="it-rwgps">
        No bike with you, or want to ride this loop with local support? <a href="/services/">Ask about rental & custom tours →</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .it-stats{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}
  .it-stats span{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);color:#fff;border-radius:999px;padding:7px 15px;font-size:.86rem}
  .it-stats b{font-weight:700}
  .it-gatehint{margin:8px 0 0;color:#e6ccd4;font-size:.88rem;max-width:380px}
  .it-gate{display:flex;gap:10px;flex-wrap:wrap;align-items:center;max-width:420px}
  .it-gate input[type='email']{flex:1;min-width:200px;border:1.5px solid rgba(255,255,255,.3);background:rgba(255,255,255,.1);color:#fff;border-radius:999px;padding:12px 18px;font-size:.9rem;font-family:var(--font-body)}
  .it-gate input[type='email']::placeholder{color:rgba(255,255,255,.5)}
  .it-consent{display:flex;gap:8px;align-items:flex-start;font-size:.72rem;color:#e6ccd4;line-height:1.4;max-width:400px;cursor:pointer}
  .it-consent input{margin-top:2px}
  .it-sent{max-width:420px;color:#fff;font-size:.92rem;line-height:1.55}
  .it-sent p{margin:0}
  .it-sent b{color:#f5a623}
  .it-err{flex-basis:100%;margin:2px 0 0;color:#ffb3b3;font-size:.8rem}
  /* la lezione del 18/8: un display dichiarato batte l'attributo hidden nel
     CSS bundlato — lo stato nascosto va imposto, sennò si vedono form e
     conferma insieme */
  .it-gate[hidden],.it-sent[hidden],.it-err[hidden]{display:none!important}
  .it-rwgps{margin:18px 0 0;font-size:.88rem;color:var(--muted)}
</style>

<script>
  /**
   * Gate email del GPX — dal 28/8/2026 IL FILE ARRIVA VIA EMAIL (decisione di
   * Andrea): in pagina non si scarica niente, mai. Regole:
   * - si ASPETTA la risposta del server prima di dire "fatto": la promessa e'
   *   un'email in arrivo, e se l'invio fallisce l'utente deve saperlo e
   *   riprovare, non fissare una inbox vuota;
   * - il TAG di intento parte per OGNI percorso richiesto — e' il dato che
   *   vale per i territori ("X contatti hanno cercato percorsi da te");
   * - localStorage solo come cortesia (precompila l'email dell'ultima volta);
   *   bloccato dal browser? tutto in try/catch, il gate funziona uguale.
   */
  const form = document.getElementById('gpx-gate') as HTMLFormElement | null;
  const sent = document.getElementById('gpx-sent');
  const store = {
    get(k: string) { try { return localStorage.getItem(k); } catch { return null; } },
    set(k: string, v: string) { try { localStorage.setItem(k, v); } catch { /* niente storage, pazienza */ } },
  };
  if (form && sent) {
    const emailInput = form.elements.namedItem('email') as HTMLInputElement;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const btnLabel = document.getElementById('gpx-btn-label');
    const err = document.getElementById('gpx-err');
    const last = store.get('cit-gpx-email');
    if (last && !emailInput.value) emailInput.value = last;

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const email = emailInput.value.trim();
      if (!email || !email.includes('@')) return;
      const consent = (form.elements.namedItem('consent') as HTMLInputElement).checked;
      const meta = form.dataset;
      err.hidden = true;
      btn.disabled = true;
      if (btnLabel) btnLabel.textContent = 'Sending…';
      let ok = false;
      try {
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email, consent,
            website: (form.elements.namedItem('website') as HTMLInputElement)?.value || '',
            itinerary: location.pathname, lang: 'en',
            area: meta.area, type: meta.type, diff: meta.diff,
            gpx: meta.gpx, name: meta.name, rwgps: meta.rwgps,
          }),
        });
        ok = res.ok && (await res.json()).ok === true;
      } catch { /* rete giu': si mostra l'errore e si riprova */ }
      if (ok) {
        store.set('cit-gpx-email', email);
        const slot = document.getElementById('gpx-sent-email');
        if (slot) slot.textContent = email;
        form.hidden = true;
        sent.hidden = false;
      } else {
        err.hidden = false;
        btn.disabled = false;
        if (btnLabel) btnLabel.textContent = 'Get the GPX';
      }
    });
  }
</script>
