---
/**
 * Noleggio bici e tour su misura — il test di domanda del doc TT365 (esca).
 * Due form, un solo endpoint (/api/service-request): la richiesta arriva a noi
 * via email, il richiedente riceve subito una conferma automatica, la risposta
 * vera parte a mano entro due giorni dopo aver sentito i partner
 * (template in docs/servizi-noleggio-tour.md). Niente prezzi ne' promesse in
 * pagina: si misura quanta domanda c'e' PRIMA di costruire il servizio.
 */
import Base from '../layouts/Base.astro';
import hero from '../assets/images/hero.jpg';
import { bgUrl } from '../lib/images';

const heroBg = await bgUrl(hero, 1600);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Bike rental and custom cycling tours in Tuscany',
  provider: { '@type': 'Organization', name: 'Tuscany Trail 365' },
  areaServed: 'Tuscany, Italy',
};
---

<Base title="Bike rental & custom tours · Tuscany Trail 365" description="Rent a bike or ask for a tailor-made cycling tour in the Tuscany Trail's Tuscany. We check with our local partners and answer personally within two working days." schema={schema}>
  <div
    class="hero"
    style={heroBg
      ? `background-image:linear-gradient(rgba(20,10,15,.55),rgba(20,10,15,.8)),url(${heroBg});background-size:cover;background-position:center`
      : undefined}
  >
    <div class="wrap">
      <div class="kick">Rental & custom tours</div>
      <h1>Arrive light.<br />Ride like a local.</h1>
      <p class="lead">A bike waiting for you, or a whole trip drawn around you — arranged with our official stays and local partners, answered personally by the team behind the Tuscany Trail.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:24px">
        <a class="btn gold" href="#rental">Rent a bike →</a>
        <a class="btn ghost-white" href="#tours">Ask for a custom tour →</a>
      </div>
    </div>
  </div>

  <section id="rental" style="background:#fff">
    <div class="wrap">
      <div class="sv-grid">
        <div>
          <h2 class="sec">Bike rental</h2>
          <p class="sub">Flying in for the Tuscany Trail, or for a weekend on our verified routes? Tell us when, where and what you ride.</p>
          <p class="sv-copy">We don't run a rental fleet ourselves. What we have is better — the people. Our official stays and the shops we trust across the territory. Send the request and we'll check real availability for your dates, then come back to you with an option or an honest answer.</p>
          <div class="chips" style="margin-top:18px">
            <span class="chip">Gravel</span>
            <span class="chip">Road</span>
            <span class="chip">E-bike</span>
            <span class="chip">MTB</span>
          </div>
          <p class="sv-note">A real person answers every request, within two working days.</p>
        </div>
        <div class="card sv-card">
          <form class="sv-form" method="post" data-service="rental" novalidate>
            <input type="text" name="website" tabindex="-1" autocomplete="off" class="sv-hp" aria-hidden="true" />
            <div class="sv-row">
              <label>Name<input type="text" name="name" required autocomplete="name" /></label>
              <label>Email<input type="email" name="email" required autocomplete="email" /></label>
            </div>
            <div class="sv-row">
              <label>From<input type="date" name="from" required /></label>
              <label>To<input type="date" name="to" required /></label>
            </div>
            <div class="sv-row">
              <label>Bike type
                <select name="bike">
                  <option>Gravel</option>
                  <option>Road</option>
                  <option>E-bike</option>
                  <option>MTB</option>
                </select>
              </label>
              <label>Riders<input type="number" name="riders" min="1" max="30" value="1" /></label>
            </div>
            <label>Pickup area<input type="text" name="area" placeholder="e.g. Campiglia Marittima, Punta Ala…" /></label>
            <label>Anything else?<textarea name="notes" rows="3" placeholder="Frame size, pedals, kids' bikes…"></textarea></label>
            <label class="sv-consent">
              <input type="checkbox" name="consent" />
              <span>Send me new verified routes and Tuscany riding tips (a few emails a year, no spam)</span>
            </label>
            <button type="submit" class="btn gold">Check availability for me →</button>
            <p class="sv-error" hidden>Something went wrong on our side. Please try again, or write to <a href="mailto:hello@cyclingintuscany.com">hello@cyclingintuscany.com</a>.</p>
          </form>
          <div class="sv-done" hidden>
            <h3>Request received ✓</h3>
            <p>Check your inbox — a confirmation is on its way. We're contacting our partners and you'll hear from us within two working days.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="tours" style="background:var(--cream)">
    <div class="wrap">
      <div class="sv-grid sv-grid-flip">
        <div>
          <h2 class="sec">Custom tours</h2>
          <p class="sub">A weekend with friends, a week with the family, a training block by the sea. Tell us the trip you have in mind.</p>
          <p class="sv-copy">Routes drawn by the people who created the Tuscany Trail, logistics by people who live here. Every tour starts as a conversation — you tell us the dream, we tell you honestly what we can build with our stays and local partners.</p>
          <p class="sv-note">No packages, no catalogue. Every request is read and answered personally.</p>
        </div>
        <div class="card sv-card">
          <form class="sv-form" method="post" data-service="tour" novalidate>
            <input type="text" name="website" tabindex="-1" autocomplete="off" class="sv-hp" aria-hidden="true" />
            <div class="sv-row">
              <label>Name<input type="text" name="name" required autocomplete="name" /></label>
              <label>Email<input type="email" name="email" required autocomplete="email" /></label>
            </div>
            <div class="sv-row">
              <label>When, roughly<input type="text" name="period" placeholder="e.g. early October 2026" /></label>
              <label>Days<input type="number" name="days" min="1" max="30" value="3" /></label>
            </div>
            <div class="sv-row">
              <label>Group size<input type="number" name="group" min="1" max="30" value="2" /></label>
              <label>Ride style
                <select name="style">
                  <option>Gravel</option>
                  <option>Road</option>
                  <option>Mixed</option>
                </select>
              </label>
            </div>
            <label>The trip you have in mind<textarea name="notes" rows="4" placeholder="Where you'd like to ride, how hard, what matters to you — food, sea, quiet roads…"></textarea></label>
            <label class="sv-consent">
              <input type="checkbox" name="consent" />
              <span>Send me new verified routes and Tuscany riding tips (a few emails a year, no spam)</span>
            </label>
            <button type="submit" class="btn gold">Tell us your trip →</button>
            <p class="sv-error" hidden>Something went wrong on our side. Please try again, or write to <a href="mailto:hello@cyclingintuscany.com">hello@cyclingintuscany.com</a>.</p>
          </form>
          <div class="sv-done" hidden>
            <h3>Request received ✓</h3>
            <p>Check your inbox — a confirmation is on its way. We'll read your trip carefully and get back to you within two working days.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .sv-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:44px;align-items:start}
  .sv-grid-flip{grid-template-columns:1.1fr 1fr}
  .sv-grid-flip > div:first-child{order:2}
  .sv-grid-flip > div:last-child{order:1}
  @media(max-width:820px){.sv-grid,.sv-grid-flip{grid-template-columns:1fr}.sv-grid-flip > div:first-child{order:1}.sv-grid-flip > div:last-child{order:2}}
  .sv-copy{color:#4a4a4a;font-size:.95rem;line-height:1.65;margin:14px 0 0;max-width:480px}
  .sv-note{margin:18px 0 0;font-size:.85rem;color:var(--muted);font-style:italic}
  .sv-card{padding:26px 28px}
  .sv-form{display:flex;flex-direction:column;gap:14px}
  .sv-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  @media(max-width:480px){.sv-row{grid-template-columns:1fr}}
  .sv-form label{display:flex;flex-direction:column;gap:6px;font-size:.78rem;font-weight:600;letter-spacing:.02em;color:#555}
  .sv-form input,.sv-form select,.sv-form textarea{border:1.5px solid var(--border);border-radius:10px;padding:10px 13px;font-size:.9rem;font-family:var(--font-body);background:#fff;color:var(--fg);width:100%}
  .sv-form input:focus,.sv-form select:focus,.sv-form textarea:focus{outline:none;border-color:var(--gold)}
  .sv-form textarea{resize:vertical}
  .sv-consent{flex-direction:row!important;gap:8px;align-items:flex-start;font-size:.72rem!important;font-weight:400!important;color:var(--muted)!important;line-height:1.4;cursor:pointer}
  .sv-consent input{width:auto;margin-top:2px}
  .sv-form .btn{border:0;margin-top:4px}
  .sv-hp{position:absolute;left:-9999px;height:0;width:0;opacity:0;pointer-events:none}
  .sv-error{margin:0;font-size:.82rem;color:#a80030}
  .sv-done h3{margin:0 0 8px}
  .sv-done p{margin:0;color:#4a4a4a;font-size:.92rem;line-height:1.6}
</style>

<script>
  /**
   * Invio dei due form. Regole:
   * - qui l'esito dell'invio CONTA (a differenza del gate GPX non c'e' nulla
   *   da sbloccare): si aspetta la risposta e si mostra errore se fallisce,
   *   cosi' nessuna richiesta si perde in silenzio;
   * - il bottone si disabilita durante l'invio per evitare doppi invii;
   * - evento GA4 best-effort, solo se gtag esiste e col consenso gia' gestito
   *   dal Consent Mode del sito.
   */
  document.querySelectorAll<HTMLFormElement>('.sv-form').forEach((form) => {
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (!form.reportValidity()) return;
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const error = form.querySelector('.sv-error') as HTMLElement;
      error.hidden = true;
      btn.disabled = true;
      btn.textContent = 'Sending…';
      const data: Record<string, unknown> = { service: form.dataset.service };
      new FormData(form).forEach((v, k) => { data[k] = v; });
      data.consent = (form.elements.namedItem('consent') as HTMLInputElement).checked;
      let ok = false;
      try {
        const res = await fetch('/api/service-request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        ok = res.ok && (await res.json()).ok === true;
      } catch { ok = false; }
      if (ok) {
        try { (window as any).gtag?.('event', 'service_request', { service: form.dataset.service }); } catch {}
        form.hidden = true;
        const done = form.parentElement?.querySelector('.sv-done') as HTMLElement | null;
        if (done) done.hidden = false;
      } else {
        error.hidden = false;
        btn.disabled = false;
        btn.textContent = form.dataset.service === 'tour' ? 'Tell us your trip →' : 'Check availability for me →';
      }
    });
  });
</script>
