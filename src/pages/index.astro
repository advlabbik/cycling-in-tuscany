---
import Base from '../layouts/Base.astro';
import Stay22MapSection from '../components/Stay22MapSection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { getCollection } from 'astro:content';
import { site } from '../../site.config';
import { bgUrl } from '../lib/images';
import heroImg from '../assets/images/hero.jpg';

const territori = await getCollection('territori');
const struttureAll = await getCollection('strutture');
const itinerari = await getCollection('itinerari');
// Ordinate per `order`, non per nome file: dal CMS lo slug viene dalla domanda (#34).
const faqEntries = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);

const getSlug = (id: string) => id.replace(/\.md$/, '');
// ordine esplicito come nel prototipo; eventuali nuove strutture finiscono in coda
const strutture = [
  ...site.struttureOrder
    .map((slug) => struttureAll.find((entry) => getSlug(entry.id) === slug))
    .filter((entry): entry is (typeof struttureAll)[number] => Boolean(entry)),
  ...struttureAll.filter((entry) => !site.struttureOrder.includes(getSlug(entry.id))),
];

const campiglia = territori.find((item) => item.data.tier === 'premium');
const monterotondo = territori.find((item) => item.data.tier !== 'premium') || territori[0];

/**
 * Sfondi CSS in versione ottimizzata (#42). Le larghezze seguono il contenitore
 * reale, non il file sorgente: hero e feature sono a tutta pagina, la card di una
 * struttura sta in una griglia da tre dentro un wrap da 1320px (~420px, quindi 800
 * copre il 2x), lo slide del carosello è fissato a 340px da `.ter-slide`.
 */
const heroBg = await bgUrl(heroImg, 1600);
const campigliaBg = await bgUrl(campiglia?.data.heroImage, 1600);
const monterotondoBg = await bgUrl(monterotondo.data.heroImage, 700);
const campigliaSlideBg = await bgUrl(campiglia?.data.heroImage, 700);
// Oggetto e non `new Map()`: in questo file `Map` è il componente della mappa,
// che ombreggia il costruttore globale.
const struttureBg: Record<string, string> = Object.fromEntries(
  await Promise.all(
    strutture.map(
      async (entry) => [entry.id, await bgUrl(entry.data.heroImage, 800)] as const,
    ),
  ),
);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqEntries.map((entry) => ({
    '@type': 'Question',
    name: entry.data.question,
    acceptedAnswer: { '@type': 'Answer', text: entry.data.answer },
  })),
};
---

<Base
  title="Tuscany Trail 365 — the Tuscany Trail's Tuscany, all year round"
  description="Handpicked territories, verified bike-friendly stays and routes ready to download."
  schema={faqSchema}
>
  <section class="hero-glass slim">
    {heroBg && <div class="hero-bg" style={`background-image:url('${heroBg}')`}></div>}
    <div class="hero-glow-gold"></div>
    <div class="hero-glow-green"></div>
    <div class="wrap hero-grid">
      <div class="hero-left">
        <div class="hero-sys-tag"><span class="sys-dot"></span>A Tuscany Trail project · year-round</div>
        <h1 class="hero-title">The Tuscany Trail's<br /><em class="hero-em">Tuscany</em>.<br />All year round.</h1>
        <p class="hero-lead">The start-line booking map, verified routes and bike-friendly stays — curated by the team that created the Tuscany Trail, the world's largest bikepacking event.</p>
        <div class="hero-actions">
          <a class="btn gold neon-glow" href="#book">Book your first night →</a>
        </div>
      </div>
    </div>
  </section>

  <Stay22MapSection
    id="book"
    lat={43.0302}
    lng={10.6055}
    venue="Fiere di Venturina — Tuscany Trail Start"
    campaign="cit-home-fiera"
    badge="★ The Tuscany Trail starts here"
    title="Book your first night in Campiglia Marittima"
    text="The map is centred on the Fiere di Venturina, where thousands of riders roll out for the Tuscany Trail every year. Everything you see is bookable — move the map to explore the rest of the coast."
  />

  {campiglia && (
    <section
      class="feature"
      style={`background-image:linear-gradient(rgba(10,5,8,.45),rgba(10,5,8,.88))${campigliaBg ? `, url('${campigliaBg}')` : ''}, linear-gradient(135deg,#2e151c,#6b4a10)`}
    >
      <div class="wrap">
        <div class="ribbon">Home of the Tuscany Trail</div>
        <div class="kick">Costa degli Etruschi ★</div>
        <h2>{campiglia.data.name}</h2>
        <p>We didn't choose it by chance as the start and finish of the Tuscany Trail. From here you get direct access to one of the finest cycling areas in all of Tuscany — and a medieval town that's a joy even off the bike.</p>
        <a class="btn gold" href={`/territori/${getSlug(campiglia.id)}`}>Discover Campiglia →</a>
      </div>
    </section>
  )}

  <section id="stays" style="background:var(--cream)">
    <div class="wrap" style="max-width:1320px">
      <SectionHeader
        tag="Verified Stays"
        title="Official Bike-Friendly Stays"
        description="Verified bases: bike storage, wash, early breakfast and their own route pack.<br>Pick the one that fits your trip."
      />
      <div class="stays-grid">
        {strutture.map((struttura) => {
          const slug = getSlug(struttura.id);
          return (
            <div class="dcard-outer" style={`--tc:${struttura.data.card.tint}`}>
              <div class="dcard">
                {struttureBg[struttura.id] && <div class="dcard-bg" style={`background-image:url('${struttureBg[struttura.id]}')`}></div>}
                <div class="dcard-grad"></div>
                <a class="dcard-cover" href={`/strutture/${slug}`} aria-label={`See ${struttura.data.name}`}></a>
                <div class="dcard-body">
                  <h3 translate="no">{struttura.data.name}</h3>
                  <p>{struttura.data.card.categoria} · {struttura.data.town} · {struttura.data.ridePack.length} routes</p>
                  <a class="dcard-btn" href={`/strutture/${slug}`}>
                    <span>See the stay</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <section
    class="feature routes-band"
    style={`background-image:linear-gradient(rgba(18,10,13,.35),rgba(18,10,13,.82))${heroBg ? `, url('${heroBg}')` : ''}`}
  >
    <div class="wrap">
      <div class="ribbon">✔ Verified routes</div>
      <div class="kick">{itinerari.length} loops · gravel & road</div>
      <h2>The ones worth riding.</h2>
      <p>Every route designed, ridden and verified by the people behind the Tuscany Trail — studied on the map with elevation, water stops and food, and the GPX ready for your bike computer.</p>
      <a class="btn gold" href="/itinerari/">Browse the {itinerari.length} routes →</a>
    </div>
  </section>

  <section id="territories" style="background:var(--cream);padding:80px 0">
    <div class="wrap">
      <div class="ter-carousel-hd">
        <div>
          <div style="display:inline-flex;align-items:center;gap:13px;margin-bottom:14px">
            <div style="height:1px;width:38px;background:#f5a623"></div>
            <span style="font-size:.65rem;font-weight:700;letter-spacing:.17em;text-transform:uppercase;color:#f5a623;font-family:var(--font-body)">Official Territories</span>
            <div style="height:1px;width:38px;background:#f5a623"></div>
          </div>
          <h2 style="font-size:2.8rem;margin:0 0 10px;color:var(--fg);font-family:var(--font-display);line-height:1.05">Territories to explore</h2>
          <p style="color:var(--muted);max-width:500px;font-size:.98rem;margin:0;line-height:1.55">The many souls of this corner of Tuscany, one ride at a time.<br />Campiglia leads — more territories are joining the map.</p>
        </div>
        <div class="ter-nav-btns">
          <button class="ter-nav-btn" id="ter-prev" aria-label="Previous"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5" /><path d="m12 19-7-7 7-7" /></svg></button>
          <button class="ter-nav-btn" id="ter-next" aria-label="Next"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg></button>
        </div>
      </div>
    </div>

    <div class="ter-carousel-scroll" id="ter-carousel-scroll">
      {campiglia && (
        <a class="ter-slide" href={`/territori/${getSlug(campiglia.id)}`}>
          <div class="ter-slide-inner" style="box-shadow:0 8px 32px rgba(184,134,11,.35)">
            {campigliaSlideBg && <div class="ter-slide-img" style={`background-image:url('${campigliaSlideBg}')`}></div>}
            <div class="ter-slide-grad"></div>
            <div class="ter-slide-body">
              <span class="ter-slide-tag">★ Home of the Tuscany Trail</span>
              <div class="ter-slide-title">{campiglia.data.name}</div>
              <div class="ter-slide-desc">Start and finish of the Tuscany Trail — medieval borough, thermal springs, Monte Calvi trails.</div>
              <div class="ter-slide-cta">Discover <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg></div>
            </div>
          </div>
        </a>
      )}
      <a class="ter-slide" href={`/territori/${getSlug(monterotondo.id)}`}>
        <div class="ter-slide-inner">
          {monterotondoBg && <div class="ter-slide-img" style={`background-image:url('${monterotondoBg}')`}></div>}
          <div class="ter-slide-grad"></div>
          <div class="ter-slide-body">
            <span class="ter-slide-tag">Official Territory</span>
            <div class="ter-slide-title">{monterotondo.data.name}</div>
            <div class="ter-slide-desc">Metalliferous Hills — geothermal landscape, white hills, routes that breathe.</div>
            <div class="ter-slide-cta">Discover <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg></div>
          </div>
        </div>
      </a>

      <div class="ter-slide ter-slide-soon">
        <div class="ter-slide-inner">
          <div class="ter-soon-glow"></div>
          <div class="ter-soon-lines"></div>
          <div class="ter-soon-icon">
            <svg width="96" height="96" viewBox="0 0 96 96" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="48" cy="48" r="44" stroke="rgba(245,166,35,.22)" stroke-width="1.5" stroke-dasharray="3 7" />
              <circle cx="48" cy="48" r="30" stroke="rgba(255,255,255,.07)" stroke-width="1" />
              <path d="M48 6 L53 43 L48 39 L43 43 Z" fill="#f5a623" />
              <path d="M48 90 L43 53 L48 57 L53 53 Z" fill="rgba(255,255,255,.22)" />
              <path d="M90 48 L53 43 L57 48 L53 53 Z" fill="rgba(255,255,255,.18)" />
              <path d="M6 48 L43 53 L39 48 L43 43 Z" fill="rgba(255,255,255,.18)" />
              <circle cx="48" cy="48" r="6" fill="#f5a623" opacity=".9" />
              <circle cx="48" cy="48" r="2.5" fill="#1a0e12" />
              <text x="48" y="24" text-anchor="middle" dominant-baseline="middle" fill="rgba(245,166,35,.55)" font-size="8" font-family="monospace" font-weight="700" letter-spacing="2">N</text>
            </svg>
          </div>
          <div class="ter-slide-body">
            <span class="soon-badge"><span class="soon-badge-dot"></span>Coming 2026</span>
            <div class="ter-slide-title">New Territory</div>
            <div class="ter-slide-desc">A new corner of Tuscany is joining the map — routes, stays and stories, curated as always.</div>
          </div>
        </div>
      </div>

    </div>

    <div class="ter-dots">
      <button class="ter-dot active" aria-label="Slide 1"></button>
      <button class="ter-dot" aria-label="Slide 2"></button>
      <button class="ter-dot" aria-label="Slide 3"></button>
    </div>
  </section>

  <section id="faq" style="background:#fff">
    <div class="wrap" style="max-width:780px">
      <SectionHeader tag="Plan your trip" title="Frequently asked questions" description="Quick answers before you go." />
      <div style="margin-top:8px">
        {faqEntries.map((entry) => (
          <details class="acc">
            <summary>{entry.data.question}</summary>
            <div class="ab">{entry.data.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  /* Le tre strutture appaiono in ordine CASUALE a ogni visita (Andrea, 15/8):
     sono partner alla pari e da telefono l'ordine decide chi viene visto.
     Lato client e non al build, altrimenti l'ordine resterebbe fisso fino al
     deploy successivo; senza JS resta l'ordine di site.config. */
  (function () {
    var grid = document.querySelector('.stays-grid');
    if (!grid) return;
    var cards = Array.from(grid.children);
    for (var i = cards.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var t = cards[i]; cards[i] = cards[j]; cards[j] = t;
    }
    cards.forEach(function (c) { grid.appendChild(c); });
  })();
</script>

<script>
  (function () {
    var sc = document.getElementById('ter-carousel-scroll');
    var prev = document.getElementById('ter-prev');
    var next = document.getElementById('ter-next');
    if (!sc || !prev || !next) return;

    var slides = sc.querySelectorAll('.ter-slide');
    var dots = document.querySelectorAll('.ter-dot');

    function active() {
      var best = 0;
      var bestD = Infinity;
      var cr = sc.getBoundingClientRect();
      slides.forEach(function (s, i) {
        var d = Math.abs(s.getBoundingClientRect().left - cr.left);
        if (d < bestD) {
          bestD = d;
          best = i;
        }
      });
      return best;
    }

    function upd() {
      var a = active();
      dots.forEach(function (d, i) {
        d.classList.toggle('active', i === a);
      });
      (prev as HTMLButtonElement).disabled = sc.scrollLeft <= 2;
      (next as HTMLButtonElement).disabled = sc.scrollLeft >= sc.scrollWidth - sc.clientWidth - 2;
    }

    function goTo(i) {
      sc.scrollBy({ left: slides[i].getBoundingClientRect().left - sc.getBoundingClientRect().left, behavior: 'smooth' });
    }

    prev.addEventListener('click', function () {
      goTo(Math.max(0, active() - 1));
    });
    next.addEventListener('click', function () {
      goTo(Math.min(slides.length - 1, active() + 1));
    });
    dots.forEach(function (d, i) {
      d.addEventListener('click', function () {
        goTo(i);
      });
    });
    sc.addEventListener('scroll', upd, { passive: true });
    upd();
  })();
</script>
